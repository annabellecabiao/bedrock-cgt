{
  "name": "@universal-middleware/node",
  "version": "0.2.2",
  "type": "module",
  "description": "Node.js utilities for universal middlewares",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./request": "./dist/request.js",
    "./response": "./dist/response.js"
  },
  "author": "Joël Charles <joel.charles91@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/magne4000/universal-middleware"
  },
  "license": "MIT",
  "dependencies": {
    "@universal-middleware/core": "^0.4.18"
  },
  "devDependencies": {
    "@swc/core": "^1.15.43",
    "@types/node": "^20.19.35",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.13",
    "typescript": "^7.0.2",
    "@universal-middleware/tsdown-config": "0.0.0"
  },
  "sideEffects": false,
  "keywords": [
    "node",
    "universal-middleware",
    "middleware",
    "handlers",
    "server-adapters",
    "universal-server",
    "request-handling"
